{
  "name": "anthony-mokhov-portfolio",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "fresh": "npm run clean && astro dev --force",
    "clean": "node -e \"for (const d of ['.astro', 'node_modules/.astro', 'node_modules/.vite', 'dist']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@google/model-viewer": "^4.4.0",
    "astro": "^7.4.4",
    "three": "^0.183.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
