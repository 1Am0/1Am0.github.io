---
// Interactive 3D board model (GLB) in a drawing-sheet frame. Drag to rotate, scroll/pinch to zoom.
// Export a GLB from KiCad (File → Export → GLB) or convert Altium's STEP export, put it in
// public/models/, then use it from project frontmatter (`model:`) or directly in MDX:
//   import BoardViewer from '../../components/BoardViewer.astro';
//   <BoardViewer src="/models/my-board.glb" alt="3D model of the sensor board" caption="PCB assembly / 3D" n={3} />
// The model-viewer library only downloads once a viewer scrolls near the screen.
import type { ImageMetadata } from 'astro';
import Sheet from './Sheet.astro';

interface Props {
  /** Path to a .glb file under public/, e.g. "/models/board.glb". */
  src: string;
  alt: string;
  caption?: string;
  n?: number;
  /** Still image shown while the model loads and if it fails (e.g. a render exported from your PCB tool). */
  poster?: ImageMetadata | string;
  /** Starting camera angle: "<azimuth> <elevation> <distance>". */
  orbit?: string;
}

const { src, alt, caption = '3D board model', n, poster, orbit = '30deg 55deg auto' } = Astro.props;
const posterSrc = typeof poster === 'string' ? poster : poster?.src;
---

<figure class="board" data-board data-orbit={orbit}>
  <Sheet zones={false}>
    <div class="stage">
      <model-viewer
        src={src}
        alt={alt}
        poster={posterSrc}
        camera-controls
        disable-pan
        touch-action="pan-y"
        camera-orbit={orbit}
        min-camera-orbit="auto 5deg auto"
        max-camera-orbit="auto 175deg auto"
        auto-rotate-delay="2500"
        rotation-per-second="12deg"
        environment-image="neutral"
        tone-mapping="neutral"
        shadow-intensity="0.7"
        shadow-softness="0.9"
        exposure="1"
        interaction-prompt="none"
        loading="lazy"
      >
        <div slot="progress-bar" class="progress" aria-hidden="true"><span></span></div>
      </model-viewer>
      <div class="status mono-label" aria-live="polite">Loading 3D model…</div>
      <div class="fallback" hidden>
        {posterSrc ? <img src={posterSrc} alt={alt} /> : <p class="mono-label">3D model unavailable</p>}
      </div>
      <div class="toolbar" hidden>
        <button type="button" data-action="reset" aria-label="Reset view">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10a6 6 0 1 0 2-4.5M4 3v3h3"></path></svg>
        </button>
        <button type="button" data-action="spin" aria-pressed="true" aria-label="Auto-rotate">
          <svg class="pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10"></path></svg>
          <svg class="play" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5l8 5-8 5z"></path></svg>
        </button>
        <button type="button" data-action="fullscreen" aria-label="Full screen">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 8V4h4M12 4h4v4M16 12v4h-4M8 16H4v-4"></path></svg>
        </button>
      </div>
    </div>
    <figcaption class="mono-label">
      <span>{n !== undefined && <>Fig. {String(n).padStart(2, '0')} — </>}{caption}</span>
      <span class="hint">Drag to rotate · Scroll to zoom</span>
    </figcaption>
  </Sheet>
</figure>

<script>
  type Viewer = HTMLElement & {
    loaded?: boolean;
    cameraOrbit: string;
    fieldOfView: string;
    resetTurntableRotation?: () => void;
    jumpCameraToGoal?: () => void;
  };

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let library: Promise<unknown> | undefined;
  const loadLibrary = () => (library ??= import('@google/model-viewer'));

  for (const figure of document.querySelectorAll<HTMLElement>('[data-board]')) {
    const viewer = figure.querySelector<Viewer>('model-viewer')!;
    const stage = figure.querySelector<HTMLElement>('.stage')!;
    const status = figure.querySelector<HTMLElement>('.status')!;
    const toolbar = figure.querySelector<HTMLElement>('.toolbar')!;
    const spinBtn = figure.querySelector<HTMLButtonElement>('[data-action="spin"]')!;
    const fullBtn = figure.querySelector<HTMLButtonElement>('[data-action="fullscreen"]')!;
    const orbit = figure.dataset.orbit!;
    let visible = false;
    let spinning = !reducedMotion.matches;

    const updateSpin = () => {
      viewer.toggleAttribute('auto-rotate', spinning && visible && !document.hidden);
      spinBtn.setAttribute('aria-pressed', String(spinning));
      spinBtn.setAttribute('aria-label', spinning ? 'Pause rotation' : 'Start rotation');
    };

    viewer.addEventListener('load', () => {
      figure.dataset.state = 'loaded';
      status.hidden = true;
      toolbar.hidden = false;
      updateSpin();
    });
    viewer.addEventListener('error', () => {
      figure.dataset.state = 'error';
      status.hidden = true;
      viewer.hidden = true;
      figure.querySelector<HTMLElement>('.fallback')!.hidden = false;
    });

    figure.querySelector('[data-action="reset"]')!.addEventListener('click', () => {
      viewer.cameraOrbit = orbit;
      viewer.fieldOfView = 'auto';
      viewer.resetTurntableRotation?.();
    });
    spinBtn.addEventListener('click', () => {
      spinning = !spinning;
      updateSpin();
    });
    if (document.fullscreenEnabled) {
      fullBtn.addEventListener('click', () =>
        document.fullscreenElement ? document.exitFullscreen() : stage.requestFullscreen(),
      );
    } else {
      fullBtn.hidden = true;
    }

    new IntersectionObserver(
      (entries) => {
        visible = entries[0].isIntersecting;
        if (visible) loadLibrary();
        updateSpin();
      },
      { rootMargin: '300px 0px' },
    ).observe(figure);
    document.addEventListener('visibilitychange', updateSpin);
    reducedMotion.addEventListener('change', () => {
      spinning = !reducedMotion.matches;
      updateSpin();
    });
  }
</script>

<style>
  .board {
    margin: 2rem 0;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: var(--surface);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .stage:fullscreen {
    aspect-ratio: auto;
  }
  model-viewer {
    width: 100%;
    height: 100%;
    background: transparent;
    --poster-color: transparent;
    outline: none;
  }
  model-viewer:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 30%;
    background: var(--accent);
    animation: load 1.2s ease-in-out infinite;
  }
  [data-state] .progress {
    display: none;
  }
  @keyframes load {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(340%);
    }
  }
  .status,
  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .status[hidden],
  .fallback[hidden] {
    display: none;
  }
  .fallback img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .toolbar {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: flex;
    gap: 0.35rem;
  }
  .toolbar[hidden] {
    display: none;
  }
  .toolbar button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .toolbar button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .toolbar button[hidden] {
    display: none;
  }
  .toolbar svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .toolbar .play {
    display: none;
  }
  [aria-pressed='false'] .play {
    display: block;
  }
  [aria-pressed='false'] .pause {
    display: none;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-top: 1px solid var(--line);
  }
  .hint {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .stage {
      aspect-ratio: 4 / 3;
    }
    .hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress span {
      animation: none;
      width: 100%;
    }
  }
</style>
