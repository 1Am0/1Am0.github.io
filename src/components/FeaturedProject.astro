---
import type { Project } from '../lib/projects';
import Sheet from './Sheet.astro';
import SpecTable from './SpecTable.astro';
import StatusBadge from './StatusBadge.astro';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: Project;
  code: string;
}

const { project, code } = Astro.props;
const { title, summary, discipline, role, tags, highlights, status, draft, repo } = project.data;
const href = `/projects/${project.id}/`;
---

<Sheet class="featured">
  <article class="layout">
    <div class="copy">
      <p class="mono-label kicker"><span>{code}</span> / {discipline}</p>
      <h3>{title}</h3>
      <p class="summary">{summary}</p>
      <SpecTable
        rows={[
          ['Drawing no.', code],
          ['Discipline', discipline],
          ['Role', role],
          ['Tools', tags.join(' / ')],
        ]}
      />
      <div class="actions">
        <a class="btn btn-primary" href={href}>Open project →</a>
        {repo && <a class="btn ext" href={repo} rel="noreferrer">Source</a>}
        <StatusBadge status={status} draft={draft} />
      </div>
    </div>
    <a class="media" href={href} tabindex="-1" aria-hidden="true">
      <ProjectVisual project={project} code={code} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 55vw" eager />
    </a>
    {
      highlights.length > 0 && (
        <div class="notes">
          <SpecTable caption="Design notes" numbered rows={highlights.map((h, i) => [String(i + 1), h])} />
        </div>
      )
    }
  </article>
</Sheet>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'copy media'
      'copy notes';
    gap: 1rem 2rem;
    padding: 1.75rem;
  }
  .copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .kicker {
    margin: 0;
  }
  .kicker span {
    color: var(--accent);
  }
  h3 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .summary {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 1.02rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .notes {
    grid-area: notes;
  }
  .media {
    grid-area: media;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    background: var(--surface-2);
    overflow: hidden;
  }
  .media {
    display: block;
    transition: border-color 0.15s;
  }
  .media:hover {
    border-color: var(--accent);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas:
        'media'
        'copy'
        'notes';
      gap: 1.5rem;
      padding: 1.25rem;
    }
    .media {
      aspect-ratio: 16 / 9;
    }
  }
</style>
