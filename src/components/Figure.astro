---
// Framed figure with a drawing-style caption. Use in project MDX:
//   import Figure from '../../components/Figure.astro';
//   import schematic from '../../assets/projects/<slug>/schematic.png';
//   <Figure src={schematic} alt="Main board schematic" n={2} caption="Schematic / power stage" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Sheet from './Sheet.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  n?: number;
}

const { src, alt, caption, n } = Astro.props;
---

<figure class="figure">
  <Sheet zones={false}>
    <Image src={src} alt={alt} widths={[720, 1080, 1600]} sizes="(max-width: 860px) 100vw, 820px" />
    <figcaption class="mono-label">
      <span>{n !== undefined && <>Fig. {String(n).padStart(2, '0')} — </>}{caption}</span>
    </figcaption>
  </Sheet>
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }
  .figure :global(img) {
    width: 100%;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
  }
  figcaption {
    padding: 0.6rem 0.75rem;
    border-top: 1px solid var(--line);
  }
</style>
