---
import { site } from '../data/site';
import Sheet from './Sheet.astro';
import SpecTable from './SpecTable.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Electrical engineering · {site.location}</p>
      <h1>{site.name}</h1>
            <p class="tagline">
        Student at {site.school} working toward electrical engineering. I design small electronic systems and
        write the firmware and software that run them.
      </p>
      {
        site.now && (
          <p class="now">
            <span class="led" aria-hidden="true" />
            <span class="mono-label">Now</span>
            {site.now}
          </p>
        )
      }
      <div class="actions">
        <a class="btn btn-primary" href="#projects">View projects</a>
        {site.resume && <a class="btn" href={site.resume}>Résumé (PDF)</a>}
        <a class="btn ext" href={site.github} rel="noreferrer">GitHub</a>
        <a class="btn ext" href={site.linkedin} rel="noreferrer">LinkedIn</a>
      </div>
    </div>

    <Sheet class="hero-sheet">
    <figure class="schematic" aria-hidden="true">
      <p class="fig mono-label">Fig. 0 — RC low-pass filter</p>
      <svg viewBox="0 0 320 200" role="presentation">
        <g class="wire">
          <path d="M20 60 H80"></path>
          <path d="M140 60 H200 V80"></path>
          <path d="M200 120 V160 H20"></path>
          <path d="M200 60 H300"></path>
          <path d="M200 160 H300"></path>
        </g>
        <path class="part" d="M80 60 l6 -10 l12 20 l12 -20 l12 20 l12 -20 l6 10"></path>
        <g class="part">
          <path d="M184 92 H216 M184 104 H216"></path>
          <path d="M200 80 V92 M200 104 V120"></path>
        </g>
        <circle class="node" cx="200" cy="60" r="3.5"></circle>
        <circle class="node" cx="200" cy="160" r="3.5"></circle>
        <circle class="term" cx="20" cy="60" r="4"></circle>
        <circle class="term" cx="20" cy="160" r="4"></circle>
        <circle class="term" cx="300" cy="60" r="4"></circle>
        <circle class="term" cx="300" cy="160" r="4"></circle>
        <text x="110" y="40">R1 10k</text>
        <text x="224" y="102">C1 100n</text>
        <text x="8" y="44">VIN</text>
        <text x="312" y="44" text-anchor="end">VOUT</text>
        <text x="8" y="184">GND</text>
        <path class="pulse" d="M20 60 H80 l6 -10 l12 20 l12 -20 l12 20 l12 -20 l6 10 H300"></path>
      </svg>
      <div class="title-block">
        <SpecTable
          rows={[
            ['Title', 'RC low-pass'],
            ['Cutoff', '1 / 2πRC ≈ 159 Hz'],
            ['Dwg no.', 'AM-000'],
          ]}
        />
      </div>
    </figure>
    </Sheet>
  </div>
</section>

<style>
  .hero {
    padding-block: 5rem 5.5rem;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 1.25rem;
  }
  .tagline {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .now {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin: -0.75rem 0 2rem;
    font-size: 0.95rem;
  }
  .led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--trace);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--trace) 20%, transparent);
    align-self: center;
  }
  .now .mono-label {
    color: var(--trace);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .schematic {
    margin: 0;
    padding: 1rem 1rem 0;
  }
  .fig {
    margin: 0 0 1rem;
  }
  .title-block {
    margin: 1.25rem -1rem 0;
    border-top: 1px solid var(--line);
  }
  .title-block :global(table) {
    margin: -1px;
    width: calc(100% + 2px);
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .wire,
  .part {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .part {
    stroke: var(--accent);
  }
  .node {
    fill: var(--text);
  }
  .term {
    fill: var(--surface);
    stroke: var(--text);
    stroke-width: 2;
  }
  text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-muted);
  }
  .pulse {
    fill: none;
    stroke: var(--trace);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 18 400;
    animation: flow 3.2s linear infinite;
  }
  @keyframes flow {
    from {
      stroke-dashoffset: 18;
    }
    to {
      stroke-dashoffset: -400;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .hero {
      padding-block: 3rem 3.5rem;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
