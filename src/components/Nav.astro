---
import { site } from '../data/site';

const base = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { label: 'Projects', href: `${base}#projects` },
  { label: 'Experience', href: `${base}#experience` },
  { label: 'Skills', href: `${base}#skills` },
  { label: 'About', href: `${base}#about` },
  { label: 'Contact', href: `${base}#contact` },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true">AM</span>
      <span class="logo-text">
        <span class="logo-name">{site.name}</span>
        <span class="logo-sub" aria-hidden="true">Electrical engineering</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links">
        <span class="sr-only">Menu</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path class="bars" d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          <path class="cross" d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <ul id="nav-links" class="links">
        {
          links.map((l, i) => (
            <li>
              <a href={l.href} data-section={l.href.split('#')[1]}>
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {l.label}
              </a>
            </li>
          ))
        }
        {site.resume && <li><a class="resume" href={site.resume}>Résumé</a></li>}
      </ul>
    </nav>
    <button class="theme-btn" type="button" aria-label="Toggle color theme">
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;

  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  const syncThemeLabel = () =>
    themeBtn?.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
  syncThemeLabel();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncThemeLabel);
  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    for (const m of document.querySelectorAll('meta[name="theme-color"]'))
      m.setAttribute('content', next === 'dark' ? '#0f1114' : '#f4f1ea');
    syncThemeLabel();
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const links = document.getElementById('nav-links');
  const setOpen = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    links?.classList.toggle('open', open);
  };
  const isOpen = () => menuBtn?.getAttribute('aria-expanded') === 'true';
  menuBtn?.addEventListener('click', () => setOpen(!isOpen()));
  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      menuBtn?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && !(e.target as HTMLElement).closest('.nav')) setOpen(false);
  });

  // Highlight the nav link for the section currently in view (home page only).
  const navLinks = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')].map((a) => [a.dataset.section, a]),
  );
  const sections = [...navLinks.keys()]
    .map((id) => document.getElementById(id!))
    .filter((el): el is HTMLElement => el !== null);
  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((a) => a.removeAttribute('aria-current'));
          navLinks.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    margin-right: auto;
  }
  .logo-mark {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.4rem;
    border: 1.5px solid var(--accent);
    color: var(--accent);
  }
  .logo-text {
    display: grid;
    line-height: 1.15;
  }
  .logo-sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    position: relative;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--text);
  }
  .links a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--accent);
  }
  .links .resume {
    color: var(--accent);
  }
  .menu-btn,
  .theme-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .menu-btn:hover,
  .theme-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .menu-btn {
    display: none;
  }
  .cross,
  .menu-btn[aria-expanded='true'] .bars {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .cross {
    display: inline;
  }
  .num {
    display: none;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .logo-sub {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .links {
      display: none;
      position: absolute;
      top: 3.75rem;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 1rem 1rem;
    }
    .links.open {
      display: flex;
      box-shadow: 0 16px 32px -16px rgb(0 0 0 / 0.25);
    }
    .links li + li {
      border-top: 1px solid var(--border);
    }
    .num {
      display: inline-block;
      width: 2.25rem;
      color: var(--accent);
    }
    .links a {
      display: block;
      padding: 0.8rem 0;
      font-size: 0.82rem;
    }
    .links a[aria-current]::after {
      display: none;
    }
  }
</style>
