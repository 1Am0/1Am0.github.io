---
// Custom icons for projects, drawn in the site's line style. Chosen with `art:` in a project's frontmatter and
// shown on its card, its archive row and its page header. Colours come from the theme, so they work in both
// light and dark mode. To add one: draw it in a 64×64 box below and add its name to the `art` enum in
// src/content.config.ts.
export type ArtName = 'chess-canopy' | 'minesweeper';

interface Props {
  name: ArtName;
  class?: string;
}

const { name, class: className } = Astro.props;

// Chess Canopy: a tree of openings growing from a chessboard; the highlighted branch is the "best line".
const tree = {
  edges: [
    [32, 50, 32, 38],
    [32, 38, 20, 29],
    [32, 38, 44, 29],
    [20, 29, 13, 19],
    [20, 29, 25, 18],
    [44, 29, 39, 18],
    [44, 29, 51, 19],
    [13, 19, 10, 10],
    [25, 18, 22, 9],
    [25, 18, 30, 9],
    [39, 18, 36, 8],
    [51, 19, 47, 9],
    [51, 19, 55, 10],
  ],
  best: [
    [32, 50, 32, 38],
    [32, 38, 44, 29],
    [44, 29, 39, 18],
    [39, 18, 36, 8],
  ],
  nodes: [
    [32, 38],
    [20, 29],
    [44, 29],
    [13, 19],
    [25, 18],
    [39, 18],
    [51, 19],
  ],
  leaves: [
    [10, 10],
    [22, 9],
    [30, 9],
    [47, 9],
    [55, 10],
  ],
};

// Minesweeper: a 3×3 corner of a board, mid-game.
type Cell = { r: number; c: number; kind: 'num'; n: 1 | 2 | 3 } | { r: number; c: number; kind: 'hidden' | 'flag' | 'mine' };
const cells: Cell[] = [
  { r: 0, c: 0, kind: 'num', n: 1 },
  { r: 0, c: 1, kind: 'num', n: 2 },
  { r: 0, c: 2, kind: 'flag' },
  { r: 1, c: 0, kind: 'num', n: 1 },
  { r: 1, c: 1, kind: 'num', n: 3 },
  { r: 1, c: 2, kind: 'hidden' },
  { r: 2, c: 0, kind: 'hidden' },
  { r: 2, c: 1, kind: 'mine' },
  { r: 2, c: 2, kind: 'hidden' },
];
const S = 16;
const O = 8;
---

<svg class:list={['art', className]} viewBox="0 0 64 64" aria-hidden="true">
  {
    name === 'chess-canopy' && (
      <g>
        <ellipse class="canopy" cx="32" cy="15" rx="27" ry="12" />
        {[0, 1, 2, 3, 4].map((i) => (
          <rect class:list={['sq', { dark: i % 2 === 1 }]} x={12 + i * 8} y="50" width="8" height="8" />
        ))}
        <rect class="board" x="12" y="50" width="40" height="8" />
        {tree.edges.map(([x1, y1, x2, y2]) => (
          <line class="edge" x1={x1} y1={y1} x2={x2} y2={y2} />
        ))}
        {tree.best.map(([x1, y1, x2, y2]) => (
          <line class="best" x1={x1} y1={y1} x2={x2} y2={y2} />
        ))}
        {tree.nodes.map(([cx, cy]) => (
          <circle class="node" cx={cx} cy={cy} r="2.2" />
        ))}
        {tree.leaves.map(([cx, cy]) => (
          <circle class="leaf" cx={cx} cy={cy} r="2.4" />
        ))}
        <circle class="leaf top" cx="36" cy="8" r="3" />
      </g>
    )
  }
  {
    name === 'minesweeper' && (
      <g>
        {cells.map((cell) => {
          const x = O + cell.c * S;
          const y = O + cell.r * S;
          const cx = x + S / 2;
          const cy = y + S / 2;
          if (cell.kind === 'num')
            return (
              <>
                <rect class="open" x={x} y={y} width={S} height={S} />
                <text class:list={['num', `n${cell.n}`]} x={cx} y={cy + 4}>
                  {cell.n}
                </text>
              </>
            );
          if (cell.kind === 'mine')
            return (
              <>
                <rect class="open boom" x={x} y={y} width={S} height={S} />
                {[0, 45, 90, 135].map((a) => (
                  <line class="spike" x1={cx} y1={cy - 6} x2={cx} y2={cy + 6} transform={`rotate(${a} ${cx} ${cy})`} />
                ))}
                <circle class="mine" cx={cx} cy={cy} r="3.8" />
                <circle class="shine" cx={cx - 1.3} cy={cy - 1.3} r="0.9" />
              </>
            );
          return (
            <>
              <rect class="hidden" x={x} y={y} width={S} height={S} />
              <path class="hi" d={`M${x + 1.5} ${y + S - 1.5} V${y + 1.5} H${x + S - 1.5}`} />
              <path class="lo" d={`M${x + 1.5} ${y + S - 1.5} H${x + S - 1.5} V${y + 1.5}`} />
              {cell.kind === 'flag' && (
                <>
                  <line class="pole" x1={cx + 1} y1={cy - 5} x2={cx + 1} y2={cy + 4.5} />
                  <path class="flag" d={`M${cx + 1} ${cy - 5} L${cx - 5} ${cy - 2.3} L${cx + 1} ${cy + 0.4} Z`} />
                  <line class="pole" x1={cx - 2.5} y1={cy + 4.5} x2={cx + 4.5} y2={cy + 4.5} />
                </>
              )}
            </>
          );
        })}
        <rect class="frame" x={O} y={O} width={S * 3} height={S * 3} />
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Chess Canopy */
  .canopy {
    stroke: var(--trace);
    stroke-width: 0.8;
    stroke-dasharray: 2 2.5;
    opacity: 0.6;
  }
  .sq {
    fill: var(--surface);
  }
  .sq.dark {
    fill: var(--text-muted);
    opacity: 0.55;
  }
  .board {
    stroke: var(--text-muted);
    stroke-width: 1;
  }
  .edge {
    stroke: var(--text-muted);
    stroke-width: 1.3;
  }
  .best {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .node {
    fill: var(--surface);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .leaf {
    fill: var(--trace);
    opacity: 0.85;
  }
  .leaf.top {
    fill: var(--accent);
    opacity: 1;
  }
  /* Minesweeper */
  .open {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 0.8;
  }
  .boom {
    fill: color-mix(in srgb, var(--accent) 22%, var(--surface));
  }
  .hidden {
    fill: var(--surface-2);
    stroke: var(--line);
    stroke-width: 0.8;
  }
  .hi {
    stroke: var(--surface);
    stroke-width: 1.4;
  }
  .lo {
    stroke: var(--text-muted);
    stroke-width: 1.2;
    opacity: 0.55;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
    stroke: none;
  }
  .n1 {
    fill: var(--text);
  }
  .n2 {
    fill: var(--trace);
  }
  .n3 {
    fill: var(--accent);
  }
  .mine {
    fill: var(--text);
  }
  .spike {
    stroke: var(--text);
    stroke-width: 1.4;
  }
  .shine {
    fill: var(--surface);
  }
  .pole {
    stroke: var(--text);
    stroke-width: 1.2;
  }
  .flag {
    fill: var(--accent);
  }
  .frame {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
</style>
