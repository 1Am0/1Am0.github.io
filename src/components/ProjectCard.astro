---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, tags, cover, coverAlt, draft } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="card">
  <div class="media">
    {
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 50vw" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span>{String(index + 1).padStart(2, '0')}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <h3>
      <a href={href}>{title}</a>
      {draft && <span class="draft">Draft</span>}
    </h3>
    <p>{summary}</p>
    <ul class="chips">
      {tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .media {
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .placeholder span {
    font-family: var(--font-mono);
    font-size: 2rem;
    color: var(--accent);
    opacity: 0.6;
  }
  .body {
    padding: 1.25rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  h3 {
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* Whole card is clickable via the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .draft {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .chips {
    margin-top: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
