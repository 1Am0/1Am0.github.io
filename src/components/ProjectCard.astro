---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: Project;
  code: string;
  // Horizontal layout, for a card that would otherwise sit alone on its row.
  wide?: boolean;
}

const { project, code, wide = false } = Astro.props;
const { title, summary, tags, cover, coverAlt, discipline, status, draft } = project.data;
const href = `/projects/${project.id}/`;
---

<article class:list={['card', { wide }]}>
  <div class="media">
    {
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 50vw" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span>{code}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="meta mono-label">
      <span>{code}</span>
      <span>{discipline}</span>
    </p>
    <h3>
      <a href={href}>{title}</a>
    </h3>
    <p class="summary">{summary}</p>
    <div class="foot">
      <ul class="chips">
        {tags.map((t) => <li class="chip">{t}</li>)}
      </ul>
      <StatusBadge status={status} draft={draft} />
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .media {
    aspect-ratio: 16 / 9;
    margin: 6px 6px 0;
    border: 1px solid var(--line);
    background: var(--surface-2);
    overflow: hidden;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 12px 12px;
  }
  .placeholder span {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    opacity: 0.7;
  }
  .body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    margin: 0;
  }
  .meta span:first-child {
    color: var(--accent);
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* Whole card is clickable via the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .foot {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem;
  }
  @media (min-width: 760px) {
    .wide {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .wide .media {
      flex: 0 0 46%;
      aspect-ratio: auto;
      min-height: 15rem;
      margin: 6px 0 6px 6px;
    }
    .wide .body {
      padding: 1.5rem 1.75rem;
    }
    .wide h3 {
      font-size: 1.45rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
