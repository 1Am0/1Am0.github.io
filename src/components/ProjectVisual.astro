---
// The picture on a project card. Uses the best image the project has:
//   cover photo → 3D model poster (a render) → PCB layout → schematic
// and otherwise draws a simple generated drawing (an IC footprint for hardware, a code window for software)
// that's different for every project, so no card is ever blank.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  code: string;
  /** Responsive image widths and sizes for the slot this visual fills. */
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}

const { project, code, widths = [480, 800], sizes = '(max-width: 820px) 100vw, 50vw', eager = false } = Astro.props;
const { cover, coverAlt, model, pcb, schematic, category, title } = project.data;

let image: { src: ImageMetadata; alt: string; photo: boolean } | undefined;
if (cover) image = { src: cover, alt: coverAlt ?? '', photo: true };
else if (model?.poster) image = { src: model.poster, alt: model.alt ?? `3D render of ${title}`, photo: false };
else if (pcb) image = { src: pcb.src, alt: pcb.alt, photo: false };
else if (schematic) image = { src: schematic.src, alt: schematic.alt, photo: false };

// Small seeded random generator, so each project's drawing is different but stable between builds.
let seed = [...project.id].reduce((h, c) => (Math.imul(h ^ c.charCodeAt(0), 2654435761) >>> 0), 2166136261);
const rand = () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const pick = <T,>(items: T[]) => items[Math.floor(rand() * items.length)];

// Hardware: a QFP/QFN-style footprint with pins on four sides and a few traces running off to pads.
const pinsPerSide = pick([5, 6, 7, 8]);
const body = 64;
const pitch = body / (pinsPerSide + 1);
const cx = 160;
const cy = 100;
const pins: { x: number; y: number; w: number; h: number }[] = [];
for (let i = 1; i <= pinsPerSide; i++) {
  const o = -body / 2 + i * pitch;
  pins.push({ x: cx + o - 2, y: cy - body / 2 - 9, w: 4, h: 7 });
  pins.push({ x: cx + o - 2, y: cy + body / 2 + 2, w: 4, h: 7 });
  pins.push({ x: cx - body / 2 - 9, y: cy + o - 2, w: 7, h: 4 });
  pins.push({ x: cx + body / 2 + 2, y: cy + o - 2, w: 7, h: 4 });
}
const traces = Array.from({ length: 5 }, (_, k) => {
  const side = k % 4;
  const i = 1 + Math.floor(rand() * pinsPerSide);
  const o = -body / 2 + i * pitch;
  // Shorter runs top/bottom so every trace ends inside the 320×200 frame.
  const len = side < 2 ? 22 + rand() * 22 : 34 + rand() * 40;
  const jog = (rand() > 0.5 ? 1 : -1) * (side < 2 ? 8 + rand() * 10 : 10 + rand() * 18);
  if (side === 0) return { d: `M${cx + o} ${cy - body / 2 - 9} v-${len / 2} l${jog / 2} -${Math.abs(jog) / 2} v-${len / 4}`, end: [cx + o + jog / 2, cy - body / 2 - 9 - len / 2 - Math.abs(jog) / 2 - len / 4] };
  if (side === 1) return { d: `M${cx + o} ${cy + body / 2 + 9} v${len / 2} l${jog / 2} ${Math.abs(jog) / 2} v${len / 4}`, end: [cx + o + jog / 2, cy + body / 2 + 9 + len / 2 + Math.abs(jog) / 2 + len / 4] };
  if (side === 2) return { d: `M${cx - body / 2 - 9} ${cy + o} h-${len} l-${Math.abs(jog) / 2} ${jog / 2}`, end: [cx - body / 2 - 9 - len - Math.abs(jog) / 2, cy + o + jog / 2] };
  return { d: `M${cx + body / 2 + 9} ${cy + o} h${len} l${Math.abs(jog) / 2} ${jog / 2}`, end: [cx + body / 2 + 9 + len + Math.abs(jog) / 2, cy + o + jog / 2] };
});

// Software: a window with code-like lines of varying indent and length.
const lines = Array.from({ length: 7 }, (_, i) => {
  const indent = i === 0 || i === 6 ? 0 : pick([1, 1, 2, 2, 3]);
  return {
    x: 66 + indent * 15,
    y: 62 + i * 16,
    w: 34 + rand() * (172 - indent * 15),
    kw: 14 + rand() * 20,
  };
});
---

<div class:list={['visual', { photo: image?.photo, drawing: image && !image.photo, generated: !image }]}>
  {
    image ? (
      <Image src={image.src} alt={image.alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    ) : category === 'hardware' ? (
      <svg viewBox="0 0 320 200" aria-hidden="true">
        {traces.map((t) => (
          <>
            <path class="trace" d={t.d} />
            <circle class="via" cx={t.end[0]} cy={t.end[1]} r="3.2" />
          </>
        ))}
        {pins.map((p) => (
          <rect class="pin" x={p.x} y={p.y} width={p.w} height={p.h} />
        ))}
        <rect class="body" x={cx - body / 2} y={cy - body / 2} width={body} height={body} rx="2" />
        <circle class="dot" cx={cx - body / 2 + 8} cy={cy - body / 2 + 8} r="2.5" />
        <text class="label" x={cx} y={cy + 4}>{code}</text>
      </svg>
    ) : (
      <svg viewBox="0 0 320 200" aria-hidden="true">
        <rect class="window" x="48" y="22" width="224" height="158" rx="3" />
        <path class="titlebar" d="M48 42 H272" />
        <circle class="light" cx="60" cy="32" r="3" />
        <circle class="light" cx="70" cy="32" r="3" />
        <circle class="light" cx="80" cy="32" r="3" />
        <text class="file" x="263" y="35">{code}</text>
        {lines.map((l) => (
          <>
            <rect class="kw" x={l.x} y={l.y} width={Math.min(l.kw, l.w)} height="6" rx="1.5" />
            {l.w > l.kw + 8 && <rect class="code" x={l.x + l.kw + 5} y={l.y} width={Math.min(l.w - l.kw - 5, 258 - l.x - l.kw)} height="6" rx="1.5" />}
          </>
        ))}
      </svg>
    )
  }
</div>

<style>
  .visual {
    width: 100%;
    height: 100%;
    background-color: var(--surface-2);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 12px 12px;
  }
  .visual.photo {
    background: var(--surface-2);
  }
  .visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .photo :global(img) {
    object-fit: cover;
  }
  .drawing :global(img) {
    object-fit: contain;
    padding: 6%;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trace {
    stroke: var(--trace);
    stroke-width: 2;
    opacity: 0.75;
  }
  .via {
    fill: var(--surface);
    stroke: var(--trace);
    stroke-width: 1.6;
  }
  .pin {
    fill: var(--accent);
    opacity: 0.85;
  }
  .body {
    fill: var(--surface);
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .dot {
    fill: var(--text-muted);
  }
  .label,
  .file {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--text-muted);
    text-anchor: middle;
  }
  .file {
    font-size: 8px;
    text-anchor: end;
  }
  .window {
    fill: var(--surface);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .titlebar {
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .light {
    fill: var(--line);
  }
  .kw {
    fill: var(--accent);
    opacity: 0.75;
  }
  .code {
    fill: var(--text-muted);
    opacity: 0.35;
  }
</style>
