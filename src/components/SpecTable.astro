---
// Key/value "title block" table, styled after the title block on an engineering drawing.
import Icon from './Icon.astro';

interface Props {
  rows: [label: string, value: string | undefined, href?: string, icon?: 'github' | 'linkedin' | 'mail' | 'resume'][];
  caption?: string;
  // Narrow label column, for numbered lists like design notes.
  numbered?: boolean;
}

const { rows, caption, numbered = false } = Astro.props;
---

<table class:list={['spec', { numbered }]}>
  {caption && <caption>{caption}</caption>}
  <tbody>
    {
      rows
        .filter(([, v]) => v)
        .map(([label, value, href, icon]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>
              {href ? (
                <a class:list={{ ext: !href.startsWith('mailto:') && !icon, 'with-icon': icon }} href={href} rel="noreferrer">
                  {icon && <Icon name={icon} />}
                  {value}
                </a>
              ) : (
                value
              )}
            </td>
          </tr>
        ))
    }
  </tbody>
</table>

<style>
  .spec {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  caption {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    border-bottom: 0;
  }
  th,
  td {
    text-align: left;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    width: 36%;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .numbered th {
    width: 3rem;
  }
  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  td {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
</style>
