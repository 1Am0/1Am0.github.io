---
// Wraps an image in a link to its full-size file; the Lightbox on the page opens it in place.
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  caption?: string;
}

const { src, caption } = Astro.props;
---

<a class="zoom" href={src.src} data-zoom data-caption={caption}>
  <slot />
  <span class="badge mono-label" aria-hidden="true">
    <svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5"></circle><path d="M12.5 12.5L17 17M6.5 8.5h4M8.5 6.5v4"></path></svg>
    Zoom
  </span>
  <span class="sr-only">(open full size)</span>
</a>

<style>
  .zoom {
    position: relative;
    display: block;
    color: inherit;
  }
  .zoom :global(img) {
    display: block;
  }
  .badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .badge svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .zoom:hover .badge,
  .zoom:focus-visible .badge {
    opacity: 1;
  }
  @media (hover: none) {
    .badge {
      opacity: 1;
    }
  }
  .zoom:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
</style>
