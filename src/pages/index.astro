---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { site, skillGroups, experience, awards } from '../data/site';

const hardware = await getProjects('hardware');
const software = await getProjects('software');
---

<Base>
  <Hero />

  <section id="projects" class="section">
    <div class="container">
      <p class="section-label">01 · Hardware</p>
      <h2 class="section-title">Electrical engineering projects</h2>
      {
        hardware.length > 0 ? (
          <div class="grid">
            {hardware.map((p, i) => (
              <ProjectCard project={p} index={i} />
            ))}
          </div>
        ) : (
          <p class="empty">Hardware write-ups are in progress. Check back soon.</p>
        )
      }

      <p class="section-label sub">02 · Software</p>
      <h2 class="section-title">Software projects</h2>
      <ul class="sw-list">
        {
          software.map((p) => (
            <li>
              <div>
                <h3>
                  <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                </h3>
                <p>{p.data.summary}</p>
              </div>
              <ul class="chips">
                {p.data.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="container">
      <p class="section-label">03 · Skills</p>
      <h2 class="section-title">Technical skills</h2>
      <div class="skills">
        {
          skillGroups.map((g) => (
            <div class="skill-group">
              <h3>{g.name}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container two-col">
      <div>
        <p class="section-label">04 · Experience</p>
        <h2 class="section-title">Experience &amp; leadership</h2>
        <ol class="timeline">
          {
            experience.map((e) => (
              <li>
                <div class="tl-head">
                  <h3>{e.role}</h3>
                  <span class="period">{e.period}</span>
                </div>
                <p class="org">{e.org}</p>
                <p>{e.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <p class="section-label">05 · Recognition</p>
        <h2 class="section-title">Awards &amp; certifications</h2>
        <ul class="awards">
          {
            awards.map((a) => (
              <li>
                <span class="award-name">{a.url ? <a href={a.url} rel="noreferrer">{a.name}</a> : a.name}</span>
                <span class="award-issuer">{a.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container about">
      <p class="section-label">06 · About</p>
      <h2 class="section-title">About me</h2>
      <p>
        I'm a student at {site.school} in San Diego, working toward a career in electrical engineering. I like
        projects that cross the hardware–software boundary: sketching a circuit, getting it working on a breadboard
        or PCB, and writing the firmware and tools around it. I picked up my programming background through AP
        Computer Science and personal projects, and I now use it to build and test hardware.
      </p>
      <p>
        Outside engineering I'm a nationally competing, Expert-rated chess player, a three-year varsity wrestler,
        and a pianist. I also tutor math, because explaining something clearly is the best test of whether I
        understand it.
      </p>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="container">
      <p class="section-label">07 · Contact</p>
      <h2 class="section-title">Get in touch</h2>
      <p class="contact-lead">
        Interested in an internship, research opportunity, or collaboration? Email me at{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn" href={site.linkedin} rel="noreferrer">LinkedIn</a>
        <a class="btn" href={site.github} rel="noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .empty {
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    margin: 0;
  }
  .sub {
    margin-top: 4rem;
  }
  .sw-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .sw-list > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 2rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .sw-list h3 {
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }
  .sw-list h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .sw-list h3 a:hover {
    color: var(--accent);
  }
  .sw-list p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .sw-list .chips {
    justify-content: flex-end;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
  }
  .skill-group {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .skill-group h3 {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .skill-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--border);
    display: grid;
    gap: 1.75rem;
  }
  .timeline li {
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 0.4rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .timeline h3 {
    font-size: 1.02rem;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .org {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.92rem;
    margin: 0.1rem 0 0.35rem;
  }
  .timeline p {
    margin: 0;
  }
  .timeline p:last-child {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .awards li {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .award-name {
    font-weight: 600;
  }
  .award-issuer {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .about p:not(.section-label) {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .contact-lead {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
    overflow-wrap: anywhere;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 820px) {
    .two-col {
      grid-template-columns: 1fr;
    }
    .sw-list > li {
      grid-template-columns: 1fr;
    }
    .sw-list .chips {
      justify-content: flex-start;
    }
  }
</style>
