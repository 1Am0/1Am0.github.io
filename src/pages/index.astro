---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import SpecTable from '../components/SpecTable.astro';
import { getProjects, getProjectCodes } from '../lib/projects';
import { Image } from 'astro:assets';
import { site, skillGroups, experience, awards, education } from '../data/site';

const hardware = await getProjects('hardware');
const software = await getProjects('software');
const codes = await getProjectCodes();
const featured = hardware.find((p) => p.data.featured) ?? hardware[0];
const otherHardware = hardware.filter((p) => p !== featured);
---

<Base>
  <Hero />

  <section id="projects" class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-label">01 · Selected work</p>
          <h2 class="section-title">Electrical engineering projects</h2>
        </div>
        {
          hardware.length > 0 && (
            <p class="mono-label count">
              {String(hardware.length).padStart(2, '0')} hardware · {String(software.length).padStart(2, '0')} software
            </p>
          )
        }
      </div>
      {
        featured ? (
          <>
            <FeaturedProject project={featured} code={codes.get(featured.id)!} />
            {otherHardware.length > 0 && (
              <div class="grid">
                {otherHardware.map((p, i) => (
                  <ProjectCard
                    project={p}
                    code={codes.get(p.id)!}
                    wide={i === otherHardware.length - 1 && otherHardware.length % 2 === 1}
                  />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="empty">Hardware write-ups are in progress. Check back soon.</p>
        )
      }

      <div class="section-head sub">
        <div>
          <p class="section-label">02 · Software</p>
          <h2 class="section-title">Software projects</h2>
        </div>
      </div>
      <ul class="rows">
        {
          software.map((p) => (
            <li class="row">
              <span class="mono-label row-code">{codes.get(p.id)}</span>
              <div class="row-main">
                <h3>
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </h3>
                <p>{p.data.summary}</p>
                <ul class="chips">
                  {p.data.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="archive-link" href="/projects/">View the full project archive <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container two-col">
      <div>
        <p class="section-label">03 · Background</p>
        <h2 class="section-title">Education &amp; experience</h2>
        <h3 class="sub-label mono-label">Education</h3>
        <div class="row">
          <span class="mono-label row-code">{education.graduation ?? 'Current'}</span>
          <div class="row-main">
            <h4>
              {education.school} <span class="org">· {education.location}</span>
            </h4>
            <p>{education.details.join(' · ')}</p>
            {
              education.coursework.length > 0 && (
                <ul class="chips" aria-label="Relevant coursework">
                  {education.coursework.map((c) => (
                    <li class="chip">{c}</li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
        <h3 class="sub-label mono-label">Experience &amp; leadership</h3>
        <ol class="rows">
          {
            experience.map((e) => (
              <li class="row">
                <span class="mono-label row-code">{e.period}</span>
                <div class="row-main">
                  <h4>
                    {e.role} <span class="org">· {e.org}</span>
                  </h4>
                  <p>{e.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="side">
        <div>
          <p class="section-label">04 · Recognition</p>
          <h2 class="section-title">Awards</h2>
          <SpecTable rows={awards.map((a) => [a.issuer, a.name, a.url ?? undefined])} />
        </div>
        <div id="skills">
          <p class="section-label">05 · Skills</p>
          <h2 class="section-title">Technical skills</h2>
          <SpecTable rows={skillGroups.map((g) => [g.name, g.items.join(' · ')])} />
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container two-col">
      <div>
        <p class="section-label">06 · About</p>
        <h2 class="section-title">About me</h2>
        <p class="about-text">
          I like work that crosses the hardware–software line: sketching a circuit, getting it running on a
          breadboard or PCB, then writing the firmware and tools around it. Outside engineering I'm an Expert-rated
          chess player, a varsity wrestler and a pianist, and I tutor math.
        </p>
        <div id="contact" class="contact">
          <p class="about-text">
            Looking for internship, research or collaboration opportunities. The fastest way to reach me is email.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
            {site.resume && <a class="btn" href={site.resume}>Résumé (PDF)</a>}
          </div>
        </div>
      </div>
      <div class="side facts">
        {
          site.photo && (
            <figure class="photo">
              <Image src={site.photo} alt={`Portrait of ${site.name}`} widths={[320, 640]} sizes="320px" />
            </figure>
          )
        }
        <SpecTable
          caption="Quick facts"
          rows={[
            ['School', site.school],
            ['Location', site.location],
            ['Focus', 'Embedded systems · Circuit design'],
            ['Also', 'Chess · Wrestling · Piano · Tutoring'],
            ['Email', site.email, `mailto:${site.email}`],
            ['LinkedIn', 'anthony-mokhov', site.linkedin],
            ['GitHub', '1Am0', site.github],
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .count {
    margin: 0 0 2rem;
  }
  @media (max-width: 640px) {
    .count {
      display: none;
    }
  }
  .grid {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .empty {
    color: var(--text-muted);
    border: 1px dashed var(--line);
    padding: 2rem;
    margin: 0;
  }
  .sub {
    margin-top: 3.5rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding: 1.25rem 1rem;
    margin-inline: -1rem;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .row:hover {
    background: var(--surface);
  }
  .row-code {
    padding-top: 0.3rem;
  }
  .row-main {
    display: grid;
    gap: 0.4rem;
  }
  .row :is(h3, h4) {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .row h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .row h3 a:hover,
  .row:hover h3 a {
    color: var(--accent);
  }
  .arrow {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform 0.15s;
  }
  .row:hover .arrow {
    transform: translateX(3px);
  }
  .row p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .org {
    font-weight: 500;
    color: var(--accent);
  }
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .side {
    display: grid;
    gap: 3rem;
    align-content: start;
  }
  .about-text {
    max-width: 36rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
  }
  .sub-label {
    margin: 0 0 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .sub-label ~ .sub-label {
    margin-top: 2rem;
  }
  .archive-link {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .archive-link span {
    transition: transform 0.15s;
  }
  .archive-link:hover span {
    transform: translateX(3px);
  }
  .photo {
    margin: 0;
    max-width: 14rem;
    padding: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .photo :global(img) {
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(0.15);
  }
  .contact {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .facts {
    padding-top: 2.6rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 820px) {
    .two-col {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .facts {
      padding-top: 0;
    }
  }
</style>
