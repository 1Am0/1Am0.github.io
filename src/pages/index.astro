---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import { getProjects, getProjectCodes } from '../lib/projects';
import { site, skillGroups, experience, awards } from '../data/site';

const hardware = await getProjects('hardware');
const software = await getProjects('software');
const codes = await getProjectCodes();
const featured = hardware.find((p) => p.data.featured) ?? hardware[0];
const otherHardware = hardware.filter((p) => p !== featured);
---

<Base>
  <Hero />

  <section id="projects" class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-label">01 · Selected work</p>
          <h2 class="section-title">Electrical engineering projects</h2>
        </div>
        {
          hardware.length > 0 && (
            <p class="mono-label count">
              {String(hardware.length).padStart(2, '0')} hardware · {String(software.length).padStart(2, '0')} software
            </p>
          )
        }
      </div>
      {
        featured ? (
          <>
            <FeaturedProject project={featured} code={codes.get(featured.id)!} />
            {otherHardware.length > 0 && (
              <div class="grid">
                {otherHardware.map((p) => (
                  <ProjectCard project={p} code={codes.get(p.id)!} />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="empty">Hardware write-ups are in progress. Check back soon.</p>
        )
      }

      <div class="section-head sub">
        <div>
          <p class="section-label">02 · Software</p>
          <h2 class="section-title">Software projects</h2>
        </div>
      </div>
      <ul class="rows">
        {
          software.map((p) => (
            <li class="row">
              <span class="mono-label row-code">{codes.get(p.id)}</span>
              <div class="row-main">
                <h3>
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </h3>
                <p>{p.data.summary}</p>
                <ul class="chips">
                  {p.data.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="container">
      <p class="section-label">03 · Skills</p>
      <h2 class="section-title">Technical skills</h2>
      <div class="skills">
        {
          skillGroups.map((g) => (
            <div class="skill-group">
              <h3>{g.name}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container two-col">
      <div>
        <p class="section-label">04 · Experience</p>
        <h2 class="section-title">Experience &amp; leadership</h2>
        <ol class="rows">
          {
            experience.map((e) => (
              <li class="row">
                <span class="mono-label row-code">{e.period}</span>
                <div class="row-main">
                  <h3>
                    {e.role} <span class="org">· {e.org}</span>
                  </h3>
                  <p>{e.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <p class="section-label">05 · Recognition</p>
        <h2 class="section-title">Awards &amp; certifications</h2>
        <ul class="awards">
          {
            awards.map((a) => (
              <li>
                <span class="award-name">{a.url ? <a class="ext" href={a.url} rel="noreferrer">{a.name}</a> : a.name}</span>
                <span class="award-issuer">{a.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container about">
      <p class="section-label">06 · About</p>
      <h2 class="section-title">About me</h2>
      <p>
        I'm a student at {site.school} in San Diego, working toward a career in electrical engineering. I like
        projects that cross the hardware–software boundary: sketching a circuit, getting it working on a breadboard
        or PCB, and writing the firmware and tools around it. I picked up my programming background through AP
        Computer Science and personal projects, and I now use it to build and test hardware.
      </p>
      <p>
        Outside engineering I'm a nationally competing, Expert-rated chess player, a three-year varsity wrestler,
        and a pianist. I also tutor math, because explaining something clearly is the best test of whether I
        understand it.
      </p>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="container">
      <p class="section-label">07 · Contact</p>
      <h2 class="section-title">Get in touch</h2>
      <p class="contact-lead">
        Interested in an internship, research opportunity, or collaboration? Email me at{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn ext" href={site.linkedin} rel="noreferrer">LinkedIn</a>
        <a class="btn ext" href={site.github} rel="noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .count {
    margin: 0 0 2rem;
  }
  .grid {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .empty {
    color: var(--text-muted);
    border: 1px dashed var(--line);
    padding: 2rem;
    margin: 0;
  }
  .sub {
    margin-top: 4rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding: 1.25rem 1rem;
    margin-inline: -1rem;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .row:hover {
    background: var(--surface);
  }
  .row-code {
    padding-top: 0.3rem;
  }
  .row-main {
    display: grid;
    gap: 0.4rem;
  }
  .row h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .row h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .row h3 a:hover,
  .row:hover h3 a {
    color: var(--accent);
  }
  .arrow {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform 0.15s;
  }
  .row:hover .arrow {
    transform: translateX(3px);
  }
  .row p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .org {
    font-weight: 500;
    color: var(--accent);
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
  }
  .skill-group {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 1.25rem;
  }
  .skill-group h3 {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .skill-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .awards li {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .award-name {
    font-weight: 600;
  }
  .award-issuer {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .about p:not(.section-label) {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .contact-lead {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
    overflow-wrap: anywhere;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 820px) {
    .two-col {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
