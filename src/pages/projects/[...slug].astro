---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const hardware = await getProjects('hardware');
  const software = await getProjects('software');
  const ordered = [...hardware, ...software];
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: ordered[i - 1], next: ordered[i + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { title, summary, category, tags, cover, coverAlt, repo, demo, date, draft } = project.data;
const { Content } = await render(project);
---

<Base title={`${title} · Anthony Mokhov`} description={summary}>
  <article class="container project">
    <a class="back" href="/#projects">← All projects</a>
    <header>
      <p class="section-label">
        {category === 'hardware' ? 'Hardware' : 'Software'}
        {date && <> · {date.getFullYear()}</>}
        {draft && <> · Draft</>}
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <ul class="chips">
        {tags.map((t) => <li class="chip">{t}</li>)}
      </ul>
      {
        (repo || demo) && (
          <div class="links">
            {repo && <a class="btn" href={repo} rel="noreferrer">Source code</a>}
            {demo && <a class="btn btn-primary" href={demo} rel="noreferrer">Live demo</a>}
          </div>
        )
      }
    </header>

    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[720, 1080, 1600]} sizes="(max-width: 1080px) 100vw, 1080px" />}

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}><span>Previous</span>{prev.data.title}</a> : <span />}
      {next && <a class="next" href={`/projects/${next.id}/`}><span>Next</span>{next.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .project {
    max-width: 780px;
    padding-block: 2.5rem 4rem;
  }
  .back {
    display: inline-block;
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.025em;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 0.75rem 0 1.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .cover {
    width: 100%;
    margin-top: 2.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .prose {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 0.5rem;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--text);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin: 1.5rem 0;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .prose :global(pre) {
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: 0.88rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: var(--surface-2);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }
  .pager a:hover {
    color: var(--accent);
  }
  .pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
