---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import SpecTable from '../../components/SpecTable.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getProjects, getProjectCodes, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const hardware = await getProjects('hardware');
  const software = await getProjects('software');
  const ordered = [...hardware, ...software];
  const codes = await getProjectCodes();
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: { project, code: codes.get(project.id)!, prev: ordered[i - 1], next: ordered[i + 1] },
  }));
}

interface Props {
  project: Project;
  code: string;
  prev?: Project;
  next?: Project;
}

const { project, code, prev, next } = Astro.props;
const { title, summary, tags, cover, coverAlt, repo, demo, date, draft, discipline, role, status, highlights } =
  project.data;
const { Content } = await render(project);
---

<Base title={`${title} · Anthony Mokhov`} description={summary}>
  <article class="container project">
    <div class="crumbs mono-label">
      <a href="/#projects">← All projects</a>
      <span>{code} / {discipline}</span>
    </div>
    <header class="head">
      <div>
        <p class="kicker mono-label"><span>{code}</span> / {discipline}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        {
          (repo || demo) && (
            <div class="links">
              {demo && <a class="btn btn-primary ext" href={demo} rel="noreferrer">Live demo</a>}
              {repo && <a class="btn ext" href={repo} rel="noreferrer">Source on GitHub</a>}
            </div>
          )
        }
      </div>
      <aside class="spec" aria-label="Project details">
        <SpecTable
          caption="Title block"
          rows={[
            ['Drawing no.', code],
            ['Discipline', discipline],
            ['Role', role],
            ['Tools', tags.join(' / ')],
            ['Date', date?.getFullYear().toString()],
          ]}
        />
        <div class="status-row"><StatusBadge status={status} draft={draft} /></div>
      </aside>
    </header>

    {
      cover && (
        <figure class="cover">
          <Sheet>
            <Image src={cover} alt={coverAlt ?? ''} widths={[720, 1080, 1600]} sizes="(max-width: 1080px) 100vw, 1000px" />
            <figcaption class="mono-label">
              <span>Fig. 01 — {coverAlt ?? title}</span>
              <span>{code}</span>
            </figcaption>
          </Sheet>
        </figure>
      )
    }

    {
      highlights.length > 0 && (
        <section class="notes" aria-label="Design notes">
          <SpecTable caption="Design notes" numbered rows={highlights.map((h, i) => [String(i + 1).padStart(2, '0'), h])} />
        </section>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}><span>Previous</span>{prev.data.title}</a> : <span />}
      {next && <a class="next" href={`/projects/${next.id}/`}><span>Next</span>{next.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-block: 1.5rem 4rem;
  }
  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 3rem;
  }
  .crumbs a {
    color: var(--text);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .kicker {
    margin: 0 0 1rem;
  }
  .kicker span {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 1.25rem 0 0;
    max-width: 38rem;
  }
  .spec {
    background: var(--surface);
  }
  .status-row {
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-top: 0;
  }
  .notes {
    max-width: 780px;
    margin-top: 2.5rem;
  }
  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .crumbs span {
      display: none;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .cover {
    margin: 3rem 0 0;
  }
  .cover :global(img) {
    width: 100%;
  }
  .cover figcaption {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0.75rem;
    border-top: 1px solid var(--line);
  }
  .prose {
    margin-top: 2.5rem;
  }
  /* Text stays at a readable measure; framed figures use the full width. */
  .prose > :global(:not(figure)) {
    max-width: 780px;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--text);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(img) {
    border: 1px solid var(--line);
    margin: 1.5rem 0;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .prose :global(pre) {
    padding: 1rem;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 0.88rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: var(--surface-2);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }
  .pager a:hover {
    color: var(--accent);
  }
  .pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
