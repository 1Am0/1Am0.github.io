---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import SpecTable from '../../components/SpecTable.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getProjects, getProjectCodes, type Project } from '../../lib/projects';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const hardware = await getProjects('hardware');
  const software = await getProjects('software');
  const ordered = [...hardware, ...software];
  const codes = await getProjectCodes();
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: { project, code: codes.get(project.id)!, prev: ordered[i - 1], next: ordered[i + 1] },
  }));
}

interface Props {
  project: Project;
  code: string;
  prev?: Project;
  next?: Project;
}

const { project, code, prev, next } = Astro.props;
const { title, summary, tags, cover, coverAlt, repo, demo, date, draft, discipline, role, status, highlights } =
  project.data;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${title} · ${site.name}`} description={summary}>
  <article class="container project">
    <div class="crumbs mono-label">
      <a href="/projects/">← All projects</a>
      <span>{code} / {discipline}</span>
    </div>
    <header class="head">
      <div>
        <p class="kicker mono-label"><span>{code}</span> / {discipline}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        {
          (repo || demo) && (
            <div class="links">
              {demo && <a class="btn btn-primary ext" href={demo} rel="noreferrer">Live demo</a>}
              {repo && <a class="btn ext" href={repo} rel="noreferrer">Source on GitHub</a>}
            </div>
          )
        }
      </div>
      <aside class="spec" aria-label="Project details">
        <SpecTable
          caption="Title block"
          rows={[
            ['Drawing no.', code],
            ['Discipline', discipline],
            ['Role', role],
            ['Tools', tags.join(' / ')],
            ['Date', date?.getFullYear().toString()],
          ]}
        />
        <div class="status-row"><StatusBadge status={status} draft={draft} /></div>
      </aside>
    </header>

    {
      cover && (
        <figure class="cover">
          <Sheet>
            <Image src={cover} alt={coverAlt ?? ''} widths={[720, 1080, 1600]} sizes="(max-width: 1080px) 100vw, 1000px" />
            <figcaption class="mono-label">
              <span>Fig. 01 — {coverAlt ?? title}</span>
              <span>{code}</span>
            </figcaption>
          </Sheet>
        </figure>
      )
    }

    <div class:list={['body', { 'has-toc': toc.length >= 3 }]}>
      <div class="main">
        {
          highlights.length > 0 && (
            <section class="notes" aria-label="Design notes">
              <SpecTable caption="Design notes" numbered rows={highlights.map((h, i) => [String(i + 1).padStart(2, '0'), h])} />
            </section>
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>
      {
        toc.length >= 3 && (
          <nav class="toc" aria-label="On this page">
            <p class="mono-label">On this page</p>
            <ol>
              {toc.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug}>
                    <span>{String(i + 1).padStart(2, '0')}</span>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}><span>Previous</span>{prev.data.title}</a> : <span />}
      {next && <a class="next" href={`/projects/${next.id}/`}><span>Next</span>{next.data.title}</a>}
    </nav>
  </article>
</Base>

<script>
  // Highlight the contents entry for the section being read.
  const tocLinks = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc, a]),
  );
  if (tocLinks.size) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          tocLinks.forEach((a) => a.removeAttribute('aria-current'));
          tocLinks.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    tocLinks.forEach((_, id) => {
      const el = document.getElementById(id!);
      if (el) observer.observe(el);
    });
  }
</script>

<style>
  .project {
    padding-block: 1.5rem 4rem;
  }
  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 3rem;
  }
  .crumbs a {
    color: var(--text);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .kicker {
    margin: 0 0 1rem;
  }
  .kicker span {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 1.25rem 0 0;
    max-width: 38rem;
  }
  .spec {
    background: var(--surface);
  }
  .status-row {
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-top: 0;
  }

  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .crumbs span {
      display: none;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .cover {
    margin: 3rem 0 0;
  }
  .cover :global(img) {
    width: 100%;
  }
  .cover figcaption span:last-child {
    white-space: nowrap;
  }
  .cover figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-top: 1px solid var(--line);
  }
  .body {
    margin-top: 2.5rem;
  }
  .body.has-toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: 4rem;
    align-items: start;
  }
  .toc {
    position: sticky;
    top: 5.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  .toc p {
    margin: 0 0 0.75rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .toc a {
    display: flex;
    gap: 0.6rem;
    padding: 0.3rem 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .toc a span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding-top: 0.15rem;
  }
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--text);
  }
  .toc a[aria-current] span {
    color: var(--accent);
  }
  .prose {
    margin-top: 0.5rem;
  }
  /* Text stays at a readable measure; framed figures use the full column. */
  .prose > :global(:not(figure)),
  .notes {
    max-width: 720px;
  }
  .prose :global(h2) {
    scroll-margin-top: 5.5rem;
  }
  @media (max-width: 1100px) {
    .body.has-toc {
      display: block;
    }
    .toc {
      display: none;
    }
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--text);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(img) {
    border: 1px solid var(--line);
    margin: 1.5rem 0;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .prose :global(pre.astro-code),
  .prose :global(pre.astro-code span) {
    background-color: var(--surface) !important;
  }
  .prose :global(pre) {
    padding: 1rem;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 0.88rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(table) {
    background: var(--surface);
    font-variant-numeric: tabular-nums;
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: var(--surface-2);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }
  .pager a:hover {
    color: var(--accent);
  }
  .pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
