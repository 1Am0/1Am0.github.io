---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, getProjectCodes } from '../../lib/projects';
import { site } from '../../data/site';

const projects = [...(await getProjects('hardware')), ...(await getProjects('software'))];
const codes = await getProjectCodes();
---

<Base title={`Project archive · ${site.name}`} description={`Every project by ${site.name}, hardware and software.`}>
  <div class="container archive">
    <div class="crumbs mono-label">
      <a href="/">← Home</a>
      <span>Drawing register</span>
    </div>
    <p class="section-label">Archive</p>
    <h1>All projects</h1>
    <p class="lead">Every hardware and software project in one register, with tools, status and source links.</p>

    <div class="table-wrap">
      <table>
        <caption class="sr-only">All projects</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Project</th>
            <th scope="col" class="hide-sm">Discipline</th>
            <th scope="col" class="hide-md">Built with</th>
            <th scope="col">Status</th>
            <th scope="col" class="hide-sm">Links</th>
          </tr>
        </thead>
        <tbody>
          {
            projects.map((p) => (
              <tr>
                <td class="code">{codes.get(p.id)}</td>
                <td class="title">
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                  </a>
                </td>
                <td class="hide-sm muted">{p.data.discipline}</td>
                <td class="hide-md">
                  <ul class="chips">
                    {p.data.tags.map((t) => (
                      <li class="chip">{t}</li>
                    ))}
                  </ul>
                </td>
                <td>
                  <StatusBadge status={p.data.status} draft={p.data.draft} />
                </td>
                <td class="hide-sm">
                  {p.data.repo && (
                    <a class="src" href={p.data.repo} rel="noreferrer">
                      <Icon name="github" />
                      Source
                    </a>
                  )}
                  {p.data.demo && (
                    <a class="ext" href={p.data.demo} rel="noreferrer">
                      Demo
                    </a>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>

<style>
  .archive {
    padding-block: 1.5rem 5rem;
  }
  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 3rem;
  }
  .crumbs a {
    color: var(--text);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    letter-spacing: -0.04em;
  }
  .lead {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin: 1rem 0 2.5rem;
    max-width: 38rem;
  }
  .table-wrap {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 6px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
  }
  th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--surface-2);
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: 0.9rem 0.8rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  tbody tr {
    transition: background 0.15s;
  }
  tbody tr:hover {
    background: var(--surface-2);
  }
  .code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .src {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .title a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .muted {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  td a.ext {
    font-size: 0.9rem;
    margin-right: 0.75rem;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .hide-md {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .hide-sm {
      display: none;
    }
    .crumbs span {
      display: none;
    }
    th,
    td {
      padding-inline: 0.55rem;
    }
  }
</style>
